```mermaid
flowchart TD
  subgraph TRIGGERS["1. Temporal Disruptions & Events"]
    EV_OVERRUN["Meeting Overrun / Delay\n(+45 min slip)"]
    EV_EMERGENCY["Emergency High-Priority Task\n(Critical deadline inserted)"]
    EV_BIOMETRIC["Biometric Crash Alert\n(Fatigue > 80% / Recovery < 30%)"]
    EV_MANUAL["User Reschedule Request\n('Push workout to 6pm')"]
  end

  subgraph DETECTION["2. Disruption Ingestion & Conflict Detection"]
    ENG_TEMP["TemporalEngine (ENG-006)\n(Temporal anchor verification)"]
    CONFLICT_DET["Conflict Detector\n(Overlapping intervals, buffer violations)"]
  end

  subgraph SOLVER["3. Constraint Satisfaction Engine"]
    SCHED_SOLV["ScheduleSolver (ENG-007)\n(Constraint Satisfaction Optimization)"]
    CONSTR_ANCHOR["Non-Negotiables / Anchors\n(Fixed meetings, sleep window, hard deadlines)"]
    CONSTR_BUFF["Transition & Buffer Rules\n(15m travel, 30m decompression)"]
    CONSTR_BIO["Physiological Capacity\n(No deep work during circadian dip)"]
  end

  subgraph REPAIR["4. Adaptive Repair Cascade"]
    ENG_REPAIR["AdaptiveRepairEngine (ENG-008)\n(Multi-tier repair policy)"]
    
    STEP1["Step 1: Buffer Absorption\n(Shrink slack intervals without shifting tasks)"]
    STEP2["Step 2: Elastic Block Compression\n(Shorten 60m focus to 45m minimum viable block)"]
    STEP3["Step 3: Low-Priority Task Deferral\n(Reschedule Tier-3 tasks to tomorrow)"]
    STEP4["Step 4: Non-Negotiable Preservation\n(Protect bedtime, gym anchor, family dinner)"]
  end

  subgraph AUDIT_EXEC["5. Plan Generation & Execution"]
    PROPOSED_PLAN["Repaired Schedule Proposal\n(Delta: modified start/end times)"]
    USER_CONSENT{"Requires User Consent?\n(High impact / anchor change)"}
    DIRECT_APPLY["Apply via WorkflowKernel (ENG-010)\n(Transactional update)"]
    PROMPT_USER["Aven Conversational Confirmation\n('I pushed low-priority reading to keep your gym block intact')"]
  end

  subgraph PERSISTENCE["6. Schedule State & Sync"]
    DB_TIMELINE[("ScheduleTimelineModel\n(Updated timeblocks)")]
    SYNC_EXT["External Calendar Sync\n(Google/Outlook Cal API updates)"]
    UI_TIMELINE["Web & Mobile Timeline UI\n(Live calendar re-render)"]
  end

  %% Flow Wiring
  EV_OVERRUN --> ENG_TEMP
  EV_EMERGENCY --> ENG_TEMP
  EV_BIOMETRIC --> ENG_TEMP
  EV_MANUAL --> ENG_TEMP

  ENG_TEMP --> CONFLICT_DET
  CONFLICT_DET --> SCHED_SOLV

  CONSTR_ANCHOR -.-> SCHED_SOLV
  CONSTR_BUFF -.-> SCHED_SOLV
  CONSTR_BIO -.-> SCHED_SOLV

  SCHED_SOLV --> ENG_REPAIR
  ENG_REPAIR --> STEP1
  STEP1 -->|Slack exhausted| STEP2
  STEP2 -->|Overlap remains| STEP3
  STEP3 --> STEP4
  STEP4 --> PROPOSED_PLAN

  PROPOSED_PLAN --> USER_CONSENT
  USER_CONSENT -->|Low impact / Auto-policy| DIRECT_APPLY
  USER_CONSENT -->|Major disruption / Tier-1 shift| PROMPT_USER
  PROMPT_USER -->|User Confirms| DIRECT_APPLY

  DIRECT_APPLY --> DB_TIMELINE
  DIRECT_APPLY --> SYNC_EXT
  DB_TIMELINE --> UI_TIMELINE
```

