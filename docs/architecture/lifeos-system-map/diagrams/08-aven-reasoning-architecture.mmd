```mermaid
flowchart TD
  subgraph INPUT["1. Perception & Intent Classification"]
    USER_MSG["User Prompt / Audio / Action"]
    CONV_ROUTER["POST /api/conversation\n(Turn Dispatcher)"]
    INTENT_DEC["Intent & Domain Classifier\n(Categorize: Task, Fitness, Schedule, General)"]
  end

  subgraph SPECIALISTS["2. Domain Specialist Agents"]
    AGT_EXEC["ExecutiveAssistantAgent (AGT-001)\n(Task prioritization & schedule coordination)"]
    AGT_FIT["FitnessSpecialistAgent (AGT-002)\n(Workout load & recovery calibration)"]
    AGT_NUTR["NutritionAgent (AGT-003)\n(Macro budgeting & fueling timing)"]
    AGT_GEN["GeneralConversationalAgent (AGT-004)\n(Reflective counseling & chat)"]
  end

  subgraph CONTEXT["3. Context & World Model Assembly"]
    HIST_CTX["Recent Conversation Turns\n(Mongo: ConversationMessageModel)"]
    TASK_CTX["Active Tasks & Projects\n(Mongo: TaskModel / GoalModel)"]
    WM_CTX["World Model Projection\n(WorldModelBridge: Physiological + Focus State)"]:::bridge
    ASSEMBLED_CTX["Assembled Reasoning Context\n(System Prompt + Context Tokens)"]
  end

  subgraph PLANNING["4. Dynamic Workflow Planning"]
    PLANNER["DynamicWorkflowPlanner (ENG-011)\n(Decomposes goal into multi-step DAG)"]
    VALIDATOR["PlanValidator (ENG-012)\n(Cycle check, capability verification, schema audit)"]
    DAG_PLAN["Validated Execution Plan DAG\n(Typed steps, input/output mappings, reversibility)"]
  end

  subgraph KERNEL["5. Sovereign Execution Kernel (Stages 1-4)"]
    SUPERVISOR["KernelSupervisor (ENG-010)\n(Coordinates execution & generation fencing)"]
    GRAPH_EXEC["WorkflowExecutionGraph\n(12-state node lifecycle, conditional branching)"]
    GOVERNANCE["ConflictGovernanceEngine\n(Bounded concurrency <= 3, path locking)"]
    CAP_REG["CapabilityRegistry\n(RFC 8785 hashing, 4-tier error classification)"]
  end

  subgraph VERIFICATION["6. Outcome Verification & Recovery"]
    VERIFIER["ObjectiveVerificationEngine (ENG-013)\n(Class 1 Read-Back, Class 2 Epistemic, Class 3 Probe)"]
    RECOVERY["CrashRecoveryEngine (ENG-014)\n(6 crash windows, CAS generation fencing)"]
    SAGA["CompensationSagaCoordinator (ENG-015)\n(Reverse DAG rollback for reversible actions)"]
  end

  subgraph PERSISTENCE_LEARN["7. Memory & Synthesis"]
    TRACE_DB[("ExecutionTraceRepository\n(Durable append-only audit log)")]
    LEARN_MAP["BehaviorPatternLibrary\n(In-memory Map - volatile gap)"]:::gap
    SYNTH["Response Synthesizer\n(Generates natural empathetic response)"]
    CLIENT_STREAM["SSE Stream / UI Markdown Render\n(To Web / Mobile App)"]
  end

  %% Flow Lines
  USER_MSG --> CONV_ROUTER
  CONV_ROUTER --> INTENT_DEC
  INTENT_DEC -->|Work/Schedule| AGT_EXEC
  INTENT_DEC -->|Workout/Body| AGT_FIT
  INTENT_DEC -->|Diet/Hydration| AGT_NUTR
  INTENT_DEC -->|Dialogue/Philosophy| AGT_GEN

  HIST_CTX --> ASSEMBLED_CTX
  TASK_CTX --> ASSEMBLED_CTX
  WM_CTX --> ASSEMBLED_CTX

  AGT_EXEC --> ASSEMBLED_CTX
  AGT_FIT --> ASSEMBLED_CTX
  AGT_NUTR --> ASSEMBLED_CTX
  AGT_GEN --> ASSEMBLED_CTX

  ASSEMBLED_CTX --> PLANNER
  PLANNER --> VALIDATOR
  VALIDATOR --> DAG_PLAN

  DAG_PLAN --> SUPERVISOR
  SUPERVISOR --> GRAPH_EXEC
  GRAPH_EXEC --> GOVERNANCE
  GOVERNANCE --> CAP_REG

  CAP_REG --> VERIFIER
  VERIFIER -->|Verification Failure| RECOVERY
  RECOVERY -->|Unrecoverable Failure| SAGA
  VERIFIER -->|Verification Success| TRACE_DB

  TRACE_DB --> SYNTH
  SYNTH --> LEARN_MAP
  SYNTH --> CLIENT_STREAM

  classDef bridge stroke:#f59e0b,stroke-width:2px,stroke-dasharray: 5 5;
