flowchart LR
    %% =========================================================================
    %% Diagram 4: Memory & Learning Flow (Intended Loop vs Actual Implementation)
    %% Shows where the closed loop of persistent behavioral learning currently breaks
    %% =========================================================================

    subgraph INGRESS_CONVERSATION ["User Interaction Ingress"]
        TURN["User Interaction / Conversation Turn<br/>(ConversationService.ts)"]
    end

    subgraph MEMORY_FORMATION_TIER ["Memory Formation & Verification Pipeline"]
        QUEUE["DurableMemoryJobQueue (QUEUE-001)<br/>• Persisted in MemoryJob collection<br/>• Monotonic retry backoff (max 3)"]
        PIPE_MEM["MemoryFormationPipeline (PIPE-002)<br/>• Candidate memory extraction<br/>• Domain classification"]
        EPIST_VERIF["EpistemicVerificationEngine (ENG-028)<br/>• Source verification<br/>• Confidence scoring (0-1)"]
        RESOLV["ContradictionResolver (ENG-029)<br/>• Detects contradictions<br/>• Supersedes outdated facts"]
        REP_MEM["MemoryRepository (REP-001)<br/>• Cosine vector similarity<br/>• Embedding generation"]
        DB_MEM[("PersonalMemory Collection<br/>(MongoDB Atlas)")]
    end

    subgraph RETRIEVAL_TIER ["Retrieval & Context Insertion"]
        RETRIEVAL["MemoryRetrievalEngine<br/>• Semantic search by vector<br/>• Top-K scored memories"]
        STM["ConversationShortTermMemory<br/>• Active entity & focus<br/>• Pending operations (TTL 10m)"]
    end

    subgraph BEHAVIORAL_LEARNING_TIER ["Behavioral & Cadence Learning Engines"]
        CHRONICLES[("ExecutionChronicle Collection<br/>• Task completion / deferral logs")]
        CADENCE["CadenceLearningEngine (ENG-023)<br/>• Day-segmented cadence (0..6)<br/>• Exponential decay (tau = 21d)"]
        
        BEHAVIOR_ENG["BehaviorEvolution (ENG-024)<br/>• Habit formation algorithm<br/>• Confidence tier evolution"]
        
        IN_MEM_MAP["In-Memory Map<br/><code>BehaviorPatternLibrary.patterns</code><br/>[CRITICAL DEFECT: Lost on Restart]"]
        
        ORPHAN_PROFILE[("BehavioralProfile Collection<br/>(MongoDB Atlas - Orphaned Model)")]
    end

    subgraph CONSTRAINT_MEMORY_GAP ["Constraint Memory & Planning Feedback Gap"]
        CONSTRAINT_MGR["ConstraintProfileManager<br/>(Conceptual / Model Only)"]
        PLANNER["DynamicWorkflowPlanner / Supervisor<br/>• Proposes future plans & schedules"]
    end

    %% Active Verified Flow
    TURN ==>|persistTurnAsync| QUEUE
    QUEUE ==>|dequeues job| PIPE_MEM
    PIPE_MEM ==>|evaluates candidate| EPIST_VERIF
    EPIST_VERIF ==>|verified candidate| RESOLV
    RESOLV ==>|reconciled record| REP_MEM
    REP_MEM ==>|writes document| DB_MEM

    DB_MEM -.->|semantic vector query| RETRIEVAL
    RETRIEVAL -.->|pinned memories| STM

    CHRONICLES ==>|ingests historical intervals| CADENCE
    CADENCE -.->|updates DayCadenceProfile| BEHAVIOR_ENG

    %% Ephemeral & Disconnected Breaks
    BEHAVIOR_ENG ==>|saves pattern| IN_MEM_MAP
    IN_MEM_MAP -.-x|DISCONNECTED: Never persists to MongoDB| ORPHAN_PROFILE
    IN_MEM_MAP -.-x|DISCONNECTED: Learned habits wiped on restart| BEHAVIOR_ENG

    %% Broken Feedback Loop to Planner
    CHRONICLES -.-x|DISCONNECTED: Repeated deferrals never convert to negative constraints| CONSTRAINT_MGR
    CONSTRAINT_MGR -.-x|DISCONNECTED: Never passed to PlanValidator or DynamicWorkflowPlanner| PLANNER

    %% Styling
    classDef verified fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
    classDef storage fill:#ede7f6,stroke:#512da8,stroke-width:2px;
    classDef defect fill:#ffebee,stroke:#c62828,stroke-width:2px;
    classDef missing fill:#fff9c4,stroke:#fbc02d,stroke-dasharray: 5 5,stroke-width:2px;

    class TURN,QUEUE,PIPE_MEM,EPIST_VERIF,RESOLV,REP_MEM,RETRIEVAL,STM,CADENCE,BEHAVIOR_ENG verified;
    class DB_MEM,CHRONICLES,ORPHAN_PROFILE storage;
    class IN_MEM_MAP defect;
    class CONSTRAINT_MGR,PLANNER missing;

