graph TB
    %% =========================================================================
    %% LifeOS Complete System Architecture Map (Post-Stage 4 Audit)
    %% Solid line: Active Verified | Dashed line: Partially Integrated | Red line: Disconnected
    %% =========================================================================

    subgraph CLIENT_TIER ["Client Applications Tier"]
        WEB["Web Application (Next.js 16)<br/><code>apps/web</code>"]
        MOB["Mobile App (Expo React Native)<br/><code>apps/mobile</code>"]
        DSK["Desktop Runtime (Tauri Shell)<br/><code>packages/desktop-runtime</code>"]
        WID["Glance Widgets & Surfaces<br/><code>apps/web/features/dashboard</code>"]
    end

    subgraph API_GATEWAY ["API Gateway & Ingress Tier (apps/web/app/api)"]
        API_CONV["/api/conversation<br/>(SSE Streaming Ingress)"]
        API_DASH["/api/dashboard<br/>(Dashboard Metrics)"]
        API_TASKS["/api/tasks & /api/goals<br/>(CRUD Handlers)"]
        API_TELEMETRY["/api/daily-log & /api/signals<br/>(Telemetry Ingress)"]
        API_MEMORY["/api/memory<br/>(Memory Queries)"]
        API_SURFACE["/api/surface<br/>(Multi-Device Sync)"]
    end

    subgraph APPLICATION_FACADE ["Application Service Facade (LifeOSApplication)"]
        SVC_CONV["ConversationService<br/><code>SVC-001</code>"]
        SVC_DASH["DashboardService<br/><code>SVC-002</code>"]
        SVC_TASK["TaskService & GoalService<br/><code>SVC-003 / SVC-004</code>"]
        SVC_WORLD["WorldService & InsightService<br/><code>SVC-005 / SVC-006</code>"]
        SVC_MEM["AssistantService & MemoryService<br/><code>SVC-007</code>"]
    end

    subgraph COGNITIVE_SUPERVISOR ["Cognitive Supervisor & Intelligence Tier"]
        AGT_SUP["Supervisor (Aven Authority)<br/><code>AGT-001</code>"]
        ENG_FAST["FastPathExecutor (<1000ms)<br/><code>ENG-001</code>"]
        ENG_SEM["SemanticIntentInterpreter<br/><code>ENG-002</code>"]
        ENG_ROUT["DynamicRouter<br/><code>ENG-003</code>"]
        
        subgraph SPECIALISTS ["Domain Specialist Agents"]
            AGT_PROD["ProductivityAgent<br/><code>AGT-002</code>"]
            AGT_HLTH["HealthAgent<br/><code>AGT-003</code>"]
            AGT_WELL["WellnessAgent<br/><code>AGT-004</code>"]
        end
        
        ENG_PAR["ParallelSpecialistExecutor<br/><code>ENG-004</code>"]
        ENG_SYN["SynthesisEngine (Conflict Arbiter)<br/><code>ENG-005</code>"]
    end

    subgraph DYNAMIC_ORCHESTRATION ["Stage 4 Dynamic Orchestration Engine"]
        ENG_PLAN["DynamicWorkflowPlanner<br/><code>ENG-006</code>"]
        ENG_VAL["PlanValidator (Kahn Acyclicity)<br/><code>ENG-007</code>"]
        ENG_GRAPH["WorkflowExecutionGraph (12-State)<br/><code>ENG-008</code>"]
        ENG_GOV["ConflictGovernanceEngine (Max 3 Concurrency)<br/><code>ENG-009</code>"]
        ENG_DISP["IterativeActionDispatcher<br/><code>ENG-010</code>"]
    end

    subgraph SOVEREIGN_KERNEL ["Sovereign Kernel Boundary Tier"]
        SVC_KERN["KernelCapabilityService<br/><code>SVC-008</code>"]
        REG_ADAPT["ActionAdapterRegistry<br/><code>REG-001</code>"]
        REG_CAP["CapabilityRegistry (~30 Caps + MCP)<br/><code>REG-002</code>"]
        ENG_IDEMP["Idempotency Gate & Audit Ledger<br/><code>ENG-011</code>"]
        ENG_VERIF["ObjectiveVerificationEngine (Stage 3)<br/><code>ENG-012</code>"]
        ENG_SAGA["CompensationSagaCoordinator<br/><code>ENG-013</code>"]
        ENG_RECOV["CrashRecoveryEngine (6 Windows)<br/><code>ENG-014</code>"]
    end

    subgraph ANALYTICAL_WORLD_BRAIN ["Analytical World Model & Learning Subsystem"]
        ENG_WM2["WorldModelV2 (Sovereign Orchestrator)<br/><code>ENG-015</code>"]
        ENG_BRIDGE["WorldModelBridge (TTL Cache Bridge)<br/><code>ENG-016</code>"]
        ENG_LIFE["LifeStateEngine (Burnout / Recovery)<br/><code>ENG-017</code>"]
        ENG_GOAL_INT["GoalIntelligenceEngine (5-Axis Tension)<br/><code>ENG-018</code>"]
        ENG_COGN["CognitiveStateEngine (Readiness / Fatigue)<br/><code>ENG-019</code>"]
        ENG_SOLV["ScheduleSolver (Transition Buffers)<br/><code>ENG-020</code>"]
        ENG_TASK_GRAPH["ExecutionGraph (Task / Goal DAG)<br/><code>ENG-021</code>"]
        ENG_REPAIR["AdaptiveRepairEngine (14 Triggers)<br/><code>ENG-022</code>"]
        ENG_CADENCE["CadenceLearningEngine (tau = 21d)<br/><code>ENG-023</code>"]
        ENG_BEHAVIOR["BehaviorEvolution (In-Memory Map)<br/><code>ENG-024</code>"]
        ENG_PREF["PreferenceAuthorityManager (5-Tier)<br/><code>ENG-025</code>"]
    end

    subgraph TELEMETRY_MEMORY ["Telemetry & Memory Pipelines"]
        SVC_TELEM["TelemetryIngestionService<br/><code>SVC-009</code>"]
        PIPE_OBS["ObservationPipeline (Deduplicating)<br/><code>PIPE-001</code>"]
        PIPE_MEM["MemoryFormationPipeline<br/><code>PIPE-002</code>"]
        QUEUE_MEM["DurableMemoryJobQueue<br/><code>QUEUE-001</code>"]
        REP_MEM["MemoryRepository (Cosine Vector)<br/><code>REP-001</code>"]
    end

    subgraph PROACTIVE_TIER ["Proactive Intelligence Tier"]
        DAEMON_PROACT["ProactivePolicyDaemon (L0-L5)<br/><code>ENG-026</code>"]
        ENG_MORN["MorningBriefingEngine (Wake Synth)<br/><code>ENG-027</code>"]
    end

    subgraph ADAPTERS_AND_PROVIDERS ["Execution Adapters & Transports"]
        ADP_DEFAULT["DefaultActionAdapters (Task/Goal/Log)<br/><code>ADP-001</code>"]
        ADP_EXT_MONO["ExternalCapabilityAdapter (4,252 LoC)<br/><code>ADP-002</code>"]
        GATEWAY_MCP["McpCapabilityGateway (Stdio/Remote)<br/><code>GATE-001</code>"]
        PROV_MODULAR["Modular Providers (GCal/Spotify/Git/Weather)<br/><code>PRV-001</code>"]
    end

    subgraph DATABASE_TIER ["Authoritative MongoDB Persistence"]
        DB_WORKSPACE[("ExecutionWorkspaceModel<br/>MOD-001")]
        DB_AUDIT[("ActionAuditRecordModel<br/>MOD-002")]
        DB_EVENTS[("ExecutionEventRecordModel<br/>MOD-003")]
        DB_EVIDENCE[("ExecutionEvidenceRecordModel<br/>MOD-004")]
        DB_TASKS[("Task & Goal Models<br/>MOD-005 / MOD-006")]
        DB_OBS[("ObservationModel (90d TTL)<br/>MOD-007")]
        DB_MEM[("PersonalMemory (Vector Store)<br/>MOD-008")]
        DB_BEHAVIOR[("BehavioralProfile (Orphaned Schema)<br/>MOD-009")]
        DB_DEEP[("UserDeepProfileModel (Orphaned Schema)<br/>MOD-010")]
        DB_BRIEF[("MorningBriefingModel<br/>MOD-011")]
    end

    %% Client to Ingress
    WEB --> API_CONV
    WEB --> API_DASH
    MOB --> API_CONV
    DSK --> API_CONV
    WID --> API_TELEMETRY

    %% Ingress to Facade
    API_CONV --> SVC_CONV
    API_DASH --> SVC_DASH
    API_TASKS --> SVC_TASK
    API_TELEMETRY --> SVC_TELEM
    API_MEMORY --> SVC_MEM

    %% Facade to Supervisor / Engines
    SVC_CONV --> AGT_SUP
    SVC_DASH --> SVC_TELEM
    SVC_DASH --> ENG_TASK_GRAPH
    SVC_DASH --> ENG_WM2
    SVC_TASK --> ENG_TASK_GRAPH

    %% Supervisor Internal Flow
    AGT_SUP --> ENG_FAST
    AGT_SUP --> ENG_SEM
    ENG_SEM --> ENG_ROUT
    ENG_ROUT -->|Strategy: FAST_PATH| ENG_FAST
    ENG_ROUT -->|Strategy: SINGLE/PARALLEL| ENG_PAR
    ENG_ROUT -->|Strategy: DYNAMIC_WORKFLOW| ENG_DISP
    
    ENG_PAR --> AGT_PROD
    ENG_PAR --> AGT_HLTH
    ENG_PAR --> AGT_WELL
    AGT_PROD --> ENG_SYN
    AGT_HLTH --> ENG_SYN
    AGT_WELL --> ENG_SYN
    ENG_SYN --> SVC_KERN

    %% FastPath & Dynamic Workflow to Kernel
    ENG_FAST --> SVC_KERN
    ENG_DISP --> ENG_PLAN
    ENG_PLAN --> ENG_VAL
    ENG_VAL --> ENG_GRAPH
    ENG_GRAPH --> ENG_GOV
    ENG_GOV --> SVC_KERN

    %% Kernel Boundary to Adapters & Verification
    SVC_KERN --> REG_ADAPT
    SVC_KERN --> ENG_IDEMP
    REG_ADAPT --> ADP_DEFAULT
    REG_ADAPT --> ADP_EXT_MONO
    REG_ADAPT --> GATEWAY_MCP
    SVC_KERN --> ENG_VERIF
    SVC_KERN --> ENG_SAGA
    ENG_DISP --> ENG_RECOV

    %% Persistence Writes
    ADP_DEFAULT --> DB_TASKS
    SVC_KERN --> DB_AUDIT
    ENG_DISP --> DB_WORKSPACE
    ENG_DISP --> DB_EVENTS
    ENG_VERIF --> DB_EVIDENCE
    PIPE_OBS --> DB_OBS
    REP_MEM --> DB_MEM

    %% Disconnected / Broken Connections
    ENG_BRIDGE -.-x|PROD GAP: Returns static mock defaults; zero DB queries| AGT_SUP
    SVC_TELEM --> PIPE_OBS
    PIPE_OBS -.-x|Disconnected: Never queried continuously| ENG_BRIDGE
    ENG_BEHAVIOR -.-x|Disconnected: Ephemeral Map; never writes to DB| DB_BEHAVIOR
    ENG_PREF -.-x|Disconnected: Never checked during dispatch| SVC_KERN
    DAEMON_PROACT -.-x|Disconnected: No background cron trigger in prod| AGT_SUP
    ENG_MORN -.-x|Disconnected: No wake trigger in prod| WEB

    %% Verified Memory Async Loop
    SVC_CONV --> QUEUE_MEM
    QUEUE_MEM --> PIPE_MEM
    PIPE_MEM --> REP_MEM

    %% Styles
    classDef verified fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
    classDef partial fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;
    classDef broken fill:#ffebee,stroke:#c62828,stroke-width:2px;
    classDef storage fill:#ede7f6,stroke:#512da8,stroke-width:2px;

    class SVC_KERN,ENG_FAST,ENG_GRAPH,ENG_GOV,ENG_IDEMP,ENG_VERIF,ENG_RECOV,ENG_SAGA,PIPE_MEM,QUEUE_MEM,REP_MEM verified;
    class AGT_SUP,ENG_SEM,ENG_PLAN,ENG_SYN,ENG_SOLV,SVC_DASH,SVC_TASK partial;
    class ENG_BRIDGE,ENG_BEHAVIOR,ENG_PREF,DAEMON_PROACT,ENG_MORN broken;
    class DB_WORKSPACE,DB_AUDIT,DB_EVENTS,DB_EVIDENCE,DB_TASKS,DB_OBS,DB_MEM storage;

