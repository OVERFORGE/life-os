flowchart TD
    %% =========================================================================
    %% Diagram 3: World Model Data Flow & Gap Analysis
    %% Shows intended vs actual data flow into the conversational Supervisor
    %% =========================================================================

    subgraph RAW_DATABASE_SOURCES ["Authoritative Database Sources (MongoDB Atlas)"]
        DB_TASKS[("Task Collection<br/>• Status, Due Date, Priority<br/>• parentTaskId, goalId")]
        DB_GOALS[("GoalHistory Collection<br/>• Target Date, Status<br/>• Milestones, Progress")]
        DB_TEMPORAL[("TemporalOccurrence Collection<br/>• Start/End Minutes<br/>• Rigidity, Location Context")]
        DB_OBSERVE[("ObservationModel Collection<br/>• Sleep Duration, Recovery Score<br/>• Schedule Density, Deep Work")]
        DB_DEEP[("UserDeepProfileModel<br/>• Chronotype, Work Windows<br/>• Communication Style")]
    end

    subgraph INGESTION_AND_BUILDERS ["State Aggregators & Builders"]
        BUILD_GRAPH["ExecutionGraph.buildFromDatabase(userId)<br/><code>ENG-021</code>"]
        PIPE_OBS["ObservationPipeline.getObservationsForWindow()<br/><code>PIPE-001</code>"]
        MGR_PREF["PreferenceAuthorityManager.getPreferences()<br/><code>ENG-025</code>"]
    end

    subgraph ANALYTICAL_ENGINES ["Analytical Calculation Wave (WorldModelV2)"]
        ENG_LIFE["LifeStateEngine (ENG-017)<br/>• Burnout / Recovery / Momentum<br/>• Stability Score (0-100)<br/>• Physiological Score"]
        ENG_GOAL["GoalIntelligenceEngine (ENG-018)<br/>• 5-Axis Tension (Urgency, Friction,<br/>  Capacity, Momentum, Alignment)<br/>• Status: aligned, strained, toxic"]
        ENG_COGN["CognitiveStateEngine (ENG-019)<br/>• Cognitive Load, Stress, Energy<br/>• Focus Readiness Score"]
    end

    subgraph KERNEL_SNAPSHOT ["KernelSnapshot Assembly"]
        BUILD_SNAP["KernelSnapshotBuilder<br/>• Assembles Subsystems<br/>• Deep Freezes Immutable Object"]
    end

    subgraph THE_BRIDGE_CHASM ["The Context Bridge Boundary (WorldModelBridge)"]
        BRIDGE_CACHE["WorldModelBridge (ENG-016)<br/><code>hydrateProjection(userId, inputOverrides)</code>"]
        STATIC_FALLBACK["STATIC DEFAULT FALLBACK:<br/>• Sleep: 420 mins (7h 0m)<br/>• Sleep Quality: 0.8 (Optimal)<br/>• Meetings: 3 mtgs (120m)<br/>• Focus Blocks: 2 left<br/>• Cognitive State: NORMAL (Fatigue: 58%)"]
    end

    subgraph CONVERSATION_SUPERVISOR ["Conversational Supervisor Pipeline"]
        SUPERVISOR["Supervisor.processRequest() (AGT-001)"]
        SEMANTIC["SemanticIntentInterpreter (ENG-002)<br/>• Ingests serializedLifeContext"]
        PLANNER["DynamicWorkflowPlanner (ENG-006)<br/>• Evaluates plan feasibility"]
    end

    %% Database to Builders
    DB_TASKS ==>|Task.find| BUILD_GRAPH
    DB_GOALS ==>|Goal.find| BUILD_GRAPH
    DB_OBSERVE -.->|ObservationModel.find| PIPE_OBS
    DB_DEEP -.-x|UNWIRED: Never called by bridge| MGR_PREF

    %% Builders to Engines
    BUILD_GRAPH ==>|graphSnapshot| ENG_GOAL
    BUILD_GRAPH ==>|graphSnapshot| ENG_LIFE
    PIPE_OBS -.->|observations []| ENG_LIFE
    PIPE_OBS -.->|observations []| ENG_COGN

    %% Engines to Snapshot
    ENG_LIFE --> BUILD_SNAP
    ENG_GOAL --> BUILD_SNAP
    ENG_COGN --> BUILD_SNAP

    %% Intended vs Actual Bridge Flow
    BUILD_SNAP -.->|When called with overrides| BRIDGE_CACHE
    BRIDGE_CACHE -->|ILifeContextProjection| SUPERVISOR
    SUPERVISOR --> SEMANTIC
    SEMANTIC --> PLANNER

    %% The Critical Disconnection Fault
    DB_OBSERVE -.x|PROD GAP: ObservationPipeline is NEVER called by WorldModelBridge in production| BRIDGE_CACHE
    BUILD_GRAPH -.x|PROD GAP: ExecutionGraph is NEVER called by WorldModelBridge in production| BRIDGE_CACHE
    BRIDGE_CACHE ==>|FALLBACK ENGAGED: inputOverrides is undefined in Supervisor.ts| STATIC_FALLBACK
    STATIC_FALLBACK ==>|Static mock context passed to prompt| SUPERVISOR

    %% Styling
    classDef storage fill:#ede7f6,stroke:#512da8,stroke-width:2px;
    classDef verified fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
    classDef warning fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;
    classDef danger fill:#ffebee,stroke:#c62828,stroke-width:2px;

    class DB_TASKS,DB_GOALS,DB_TEMPORAL,DB_OBSERVE,DB_DEEP storage;
    class BUILD_GRAPH,ENG_LIFE,ENG_GOAL,ENG_COGN,BUILD_SNAP,SUPERVISOR,SEMANTIC,PLANNER verified;
    class BRIDGE_CACHE warning;
    class STATIC_FALLBACK danger;

