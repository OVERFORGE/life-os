# LifeOS Environment Configuration Template
# Never commit real credentials or production URIs to version control.

# Database (Runtime)
MONGODB_URI=mongodb://127.0.0.1:27017/life-os

# Database (Isolated Real-DB Integration Testing - NEVER set to life-os)
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/life-os-stage0-test
USE_MEMORY_REPLSET=true

# LLM & Audio Providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WHISPER_MODEL=whisper-large-v3-turbo

# Runtime Toggles
USE_LOCAL_EMBEDDINGS=true
ENABLE_FAST_SEMANTIC_FILLER=false
LIFEOS_LOG_TRACES=false
# Set to true only for local single-process dev without `inngest dev` or `pnpm run daemon:outbox`
LIFEOS_LOCAL_OUTBOX_FALLBACK=false
LIFEOS_TRACE_RETENTION_DAYS=14

# LangSmith Observability (Optional — fail-open when disabled)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=life-os
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Admin Console Access Control (comma-separated emails; fail-closed)
ADMIN_EMAILS=
