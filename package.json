{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "turbo dev --filter=web",
    "dev:desktop": "node scripts/dev.mjs",
    "dev:tauri": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/dev-tauri.ps1",
    "dev:all": "node scripts/dev.mjs",
    "build": "pnpm --filter web build",
    "build-desktop": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/build-desktop.ps1",
    "dev:mobile": "pnpm --filter mobile start",
    "lint": "turbo lint",
    "build:mobile": "cd apps/mobile && eas build -p android --profile preview",
    "postinstall": "node scripts/patch-expo-modules.js",
    "verify:architecture": "npx tsx scripts/verify-semantic-architecture.ts",
    "test:architecture": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/architecture/*.test.ts",
    "audit:v3": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/*.test.ts",
    "test:routineai": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/phase1TemporalContracts.test.ts packages/execution-kernel/src/testing/phase2GoalEvolutionAndAttribution.test.ts packages/execution-kernel/src/testing/phase3UnifiedTimelineAndSolver.test.ts packages/execution-kernel/src/testing/phase4CadenceAndConstraints.test.ts packages/execution-kernel/src/testing/phase5AvenSemanticTemporalExecution.test.ts packages/execution-kernel/src/testing/phase6CalendarAndControlSurface.test.ts",
    "test:reality": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/phase1WorldModelBridge.test.ts packages/execution-kernel/src/testing/reality/phase2ContinuousTelemetry.test.ts packages/execution-kernel/src/testing/reality/phase3CognitiveState.test.ts packages/execution-kernel/src/testing/reality/phase4DeepUserModel.test.ts packages/execution-kernel/src/testing/reality/phase5BehavioralRelationshipPhysical.test.ts packages/execution-kernel/src/testing/reality/phase6CrossDomainIntelligence.test.ts packages/execution-kernel/src/testing/reality/phase7InterventionOutcomeLearning.test.ts packages/execution-kernel/src/testing/reality/phase8ProactiveEngine.test.ts packages/execution-kernel/src/testing/reality/phase9MorningAvenBriefing.test.ts packages/execution-kernel/src/testing/reality/phase10LangGraphPilot.test.ts packages/execution-kernel/src/testing/reality/phase11McpPilot.test.ts packages/execution-kernel/src/testing/reality/phase12ProviderDecomposition.test.ts packages/execution-kernel/src/testing/reality/phase13ProductionHardening.test.ts packages/execution-kernel/src/testing/reality/phase14LongitudinalSimulation.test.ts packages/execution-kernel/src/testing/reality/phase15AutonomousLifeManagement.test.ts",
    "test:stress": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/stressTestSuite200.test.ts",
    "test:step5": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/step5/*.test.ts",
    "typecheck:all": "pnpm --filter web exec tsc --noEmit && pnpm --filter desktop exec tsc -p tsconfig.main.json --noEmit && pnpm exec tsc -p apps/desktop/tsconfig.json --noEmit && pnpm --filter mobile exec tsc --noEmit && pnpm --filter @life-os/design-system typecheck && pnpm exec tsc -p packages/execution-kernel/tsconfig.json --noEmit",
    "test:offline": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/stage0ModelRegistry.test.ts packages/execution-kernel/src/testing/stage0ObservabilityAndFastFail.test.ts packages/execution-kernel/src/testing/step2/*.test.ts packages/execution-kernel/src/testing/step3/*.test.ts packages/execution-kernel/src/testing/step4/*.test.ts packages/execution-kernel/src/testing/step5/*.test.ts packages/execution-kernel/src/testing/phase1WorldModelBridge.test.ts packages/execution-kernel/src/testing/phase18ProductionHarnessVerification.test.ts packages/execution-kernel/src/testing/phase19IterativeAgencyEngine.test.ts packages/execution-kernel/src/testing/phase20DurableMemoryEngine.test.ts packages/execution-kernel/src/testing/phase21OutcomeVerification.test.ts packages/execution-kernel/src/testing/phase22DynamicWorkflowOrchestration.test.ts packages/execution-kernel/src/testing/stressTestSuite200.test.ts",
    "test:db": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage0DbIsolation.test.ts",
    "test:stage1": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage1CapabilityContracts.test.ts packages/execution-kernel/src/testing/stage1ReadCapabilitiesDb.test.ts packages/execution-kernel/src/testing/stage1RuntimeIntegration.test.ts",
    "test:stage2": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage2AgenticLifecycleOffline.test.ts packages/execution-kernel/src/testing/stage2AgenticPipelineDb.test.ts",
    "test:stage2:live": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage2LiveProviderSmoke.test.ts",
    "test:stage3": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage3StreamContracts.test.ts packages/execution-kernel/src/testing/stage3StreamingLlm.test.ts packages/execution-kernel/src/testing/stage3SupervisorLifecycleOffline.test.ts packages/execution-kernel/src/testing/stage3StreamingLifecycleDb.test.ts packages/execution-kernel/src/testing/stage3WebSseParser.test.ts packages/execution-kernel/src/testing/stage3PostActivationStream.test.ts",
    "test:stage3:live": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage3LiveStreamingSmoke.test.ts",
    "test:stage4": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage4MemoryPersistenceDb.test.ts packages/execution-kernel/src/testing/stage4EmbeddingsAndSearch.test.ts packages/execution-kernel/src/testing/stage4MemoryQueueAndExtraction.test.ts packages/execution-kernel/src/testing/stage4MemoryCapabilityDb.test.ts packages/execution-kernel/src/testing/stage4MemoryOrchestrationDb.test.ts packages/execution-kernel/src/testing/stage4MemoryGroundingAndQualityDb.test.ts",
    "test:stage4:live": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage4LiveMemorySmoke.test.ts",
    "test:stage5": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage5OutboxMutationsDb.test.ts packages/execution-kernel/src/testing/stage5ConsumersAndTelemetryDb.test.ts packages/execution-kernel/src/testing/stage5InngestAndDeliveryDb.test.ts packages/execution-kernel/src/testing/stage5SseAndInvalidation.test.ts packages/execution-kernel/src/testing/stage5ProjectionAndRouting.test.ts packages/execution-kernel/src/testing/stage5EndToEndReactivityDb.test.ts",
    "test:stage6": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage6OutboxAndSecurityDb.test.ts packages/execution-kernel/src/testing/stage6SemanticAndAstCompliance.test.ts packages/execution-kernel/src/testing/stage6BlackBoxScenariosDb.test.ts packages/execution-kernel/src/testing/stage6AdversarialAndReplayDb.test.ts",
    "test:stage6:live": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test-concurrency=1 --test packages/execution-kernel/src/testing/stage6LiveE2ESmoke.test.ts",
    "verify:stage0": "pnpm run typecheck:all && pnpm --filter @life-os/design-system lint && pnpm run verify:architecture && pnpm run test:architecture && pnpm run test:offline && pnpm run test:routineai && pnpm run test:db",
    "verify:stage1": "pnpm run verify:stage0 && pnpm run test:stage1",
    "verify:stage2": "pnpm run verify:stage1 && pnpm run test:stage2",
    "verify:stage3": "pnpm run verify:stage2 && pnpm --filter web exec eslint features/chat/sseStreamParser.ts && pnpm run test:stage3",
    "verify:stage4": "pnpm run verify:stage3 && pnpm run test:stage4",
    "verify:stage5": "pnpm run verify:stage4 && pnpm run test:stage5",
    "verify:stage6": "pnpm run verify:stage5 && pnpm --filter mobile exec eslint app/ utils/ services/ hooks/ --quiet && pnpm --filter web exec eslint app/api lib server hooks features/chat features/daily-log features/health features/nutrition features/goals features/gym --quiet && pnpm --filter desktop run build && pnpm --filter web exec next build --webpack && pnpm run test:stage6",
    "daemon:outbox": "npx tsx scripts/outbox-worker-daemon.ts",
    "daemon:autonomous": "npx tsx scripts/autonomous-worker-daemon.ts",
    "wake:record": "node tools/aven-wake-detector/training/record_server.mjs",
    "wake:share": "node tools/aven-wake-detector/training/share_server.mjs",
    "wake:validate": "node tools/aven-wake-detector/training/validate_dataset.mjs"
  },
  "devDependencies": {
    "babel-preset-expo": "~13.0.0",
    "mongodb-memory-server": "^11.4.0",
    "turbo": "^2.0.0"
  }
}
