{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "turbo dev --filter=web",
    "dev:all": "turbo dev",
    "build": "pnpm --filter web build",
    "build-desktop": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/build-desktop.ps1",
    "dev:desktop": "pnpm --filter desktop dev",
    "lint": "turbo lint",
    "build:mobile": "cd apps/mobile && eas build -p android --profile preview",
    "audit:v3": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/*.test.ts",
    "test:stress": "npx tsx --tsconfig packages/execution-kernel/tsconfig.json --test packages/execution-kernel/src/testing/stressTestSuite200.test.ts"
  },
  "devDependencies": {
    "babel-preset-expo": "~13.0.0",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
}
