# ============================================
# Desktop App (Tauri) — Build Artifacts
# ============================================

# Rust compiled output (very large — compiled at build time)
apps/desktop/src-tauri/target/

# Node.js binary bundled for sidecar (~70MB — downloaded by build script)
apps/desktop/src-tauri/bin/

# Compiled Next.js standalone web app output (generated by build-desktop script)
apps/desktop/src-tauri/resources/web/

# Generated Tauri capability schemas (auto-generated from Cargo)
apps/desktop/src-tauri/gen/schemas/

# Vite/frontend build output for desktop
apps/desktop/dist/
apps/desktop/dist-ssr/

# Generated bootstrapper (created by build-desktop script)
apps/desktop/start.cjs

# Desktop app local env overrides
apps/desktop/.env
apps/desktop/.env.local

