<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="15dp">

    <!-- Header Row: Brand, Status Dot & Mode Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Dot: Valid RemoteViews ImageView -->
        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_dot_gray"
            android:contentDescription="Status indicator" />

        <TextView
            android:id="@+id/widget_header_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="LIFEOS"
            android:textColor="#88888E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg_muted"
            android:fontFamily="sans-serif-medium"
            android:text="CLEAR"
            android:textColor="#88888E"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Content Section: Mutually Exclusive State Containers -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <!-- 1. CLEAR STATE (Calm Ambient Experience with Next Anchor) -->
        <LinearLayout
            android:id="@+id/container_state_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:id="@+id/widget_clear_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="You're clear."
                android:textColor="#F6F3F1"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_clear_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="All commitments clear"
                android:textColor="#88888E"
                android:textSize="12sp" />

            <!-- Next Commitment Card Anchor -->
            <LinearLayout
                android:id="@+id/widget_clear_next_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/widget_subcard_bg"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/widget_clear_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="NEXT"
                    android:textColor="#66666D"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_clear_next_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="No upcoming commitments"
                        android:textColor="#F6F3F1"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/widget_clear_next_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginLeft="8dp"
                        android:fontFamily="sans-serif"
                        android:text=""
                        android:textColor="#88888E"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. UPCOMING STATE (Focus Countdown) -->
        <LinearLayout
            android:id="@+id/container_state_upcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_upcoming_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#F6F3F1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_upcoming_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="#88888E"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. ACTIVE STATE (Live Chronometer & Focus) -->
        <LinearLayout
            android:id="@+id/container_state_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_active_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#F6F3F1"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Chronometer
                    android:id="@+id/widget_chronometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E8414A"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_chronometer_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="#66666D"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_active_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="#88888E"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. PROPOSAL STATE (Ready to Start) -->
        <LinearLayout
            android:id="@+id/container_state_proposal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_proposal_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#F6F3F1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_proposal_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:text="Ready to start?"
                android:textColor="#88888E"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Flexible Vertical Spacer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Action Row: Controls & Aven Summon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Dynamic Action Controls Container -->
        <LinearLayout
            android:id="@+id/container_action_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Start Action Button (Amber Accent with Vector Icon, Zero Emoji) -->
            <LinearLayout
                android:id="@+id/btn_action_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/widget_btn_obsidian_accent"
                android:contentDescription="Start scheduled task"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_action_play"
                    android:contentDescription="" />

                <TextView
                    android:id="@+id/txt_action_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginLeft="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Start"
                    android:textColor="#F59E0B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Done Action Button (Crimson Affirm with Vector Checkmark, Zero Emoji) -->
            <LinearLayout
                android:id="@+id/btn_action_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/widget_btn_crimson"
                android:contentDescription="Complete active task"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_action_check"
                    android:contentDescription="" />

                <TextView
                    android:id="@+id/txt_action_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginLeft="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Done"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Pause Action Button (Neutral with Vector Pause, Zero Emoji) -->
            <LinearLayout
                android:id="@+id/btn_action_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_btn_neutral"
                android:contentDescription="Pause active task"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_action_pause"
                    android:contentDescription="" />
            </LinearLayout>

            <!-- Extend 15m Action Button (Neutral, Clean Typography) -->
            <TextView
                android:id="@+id/btn_action_extend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_btn_neutral"
                android:contentDescription="Extend task 15 minutes"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="+15m"
                android:textColor="#F6F3F1"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Horizontal Spacer pushing Aven summon button to right -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Ambient Dual Ingress Actions: Voice (Mic) & Text (Message) (Zero Emoji, No Text Label) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Voice Action Button (Monochrome Vector Mic) -->
            <LinearLayout
                android:id="@+id/widget_aven_voice_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:gravity="center"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Summon Voice Aven">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_aven_mic"
                    android:contentDescription="" />
            </LinearLayout>

            <!-- Text Action Button (Monochrome Vector Message) -->
            <LinearLayout
                android:id="@+id/widget_aven_text_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:minWidth="44dp"
                android:minHeight="44dp"
                android:gravity="center"
                android:background="@drawable/widget_button_bg"
                android:contentDescription="Summon Text Aven">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_action_message"
                    android:contentDescription="" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

