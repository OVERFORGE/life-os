<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#161618"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: LifeOS Pill & Status Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Status Dot (Red when active, muted when glance) -->
        <View
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#E8414A" />

        <TextView
            android:id="@+id/widget_header_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="LIFEOS"
            android:textColor="#A0A0A5"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_mode_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="GLANCE"
            android:textColor="#E8414A"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Main Title & Time -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-bold"
        android:maxLines="2"
        android:text="All commitments clear"
        android:textColor="#F6F3F1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="Silence is a successful state"
        android:textColor="#88888E"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_meta_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="Tap to review"
            android:textColor="#66666D"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_aven_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2A2B2F"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="AVEN"
            android:textColor="#F6F3F1"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
