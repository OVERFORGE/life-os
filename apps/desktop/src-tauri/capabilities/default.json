{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "context": {
    "local": true
  },
  "remote": {
    "urls": ["http://localhost:3456/*", "http://localhost:*/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    "deep-link:default"
  ]
}